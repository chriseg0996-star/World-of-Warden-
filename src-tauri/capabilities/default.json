{
  "$schema": "https://schema.tauri.app/schema/2/capability.json",
  "identifier": "default",
  "description": "Default desktop launcher capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-unmaximize"
  ]
}
